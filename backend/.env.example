# Backend settings. Copy backend/.env.example to backend/.env and fill in the blanks.
# Keep backend/.env private. Never put these secrets in the root/frontend .env.
# Existing system environment variables take priority over backend/.env.

# --- API keys ---
# Sarvam: required only for translating generated RCA reports.
SARVAM_API_KEY=""
# Groq: required when LLM_PROVIDER is "groq".
GROQ_API_KEY=""

# --- Protected example deletion ---
# Choose a password for deleting shared/predefined example files.
EXAMPLE_DELETE_PASSWORD=""

# --- Supabase ---
# Optional database password for your reference; the current app does not read it.
# This is NOT the secret API key used by SUPABASE_SERVICE_ROLE_KEY below.
SUPABASE_PASSWORD=""
# Project URL, for example https://your-project-ref.supabase.co.
SUPABASE_URL=""
# Backend-only secret API key (sb_secret_...) or legacy service_role JWT.
# Do not use the database password or an anon/publishable key here.
# URL + API key are required for persistent example deletions in hosted mode.
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI provider ---
# Local Ollama: "ollama". Hosted Groq: "groq" (requires GROQ_API_KEY).
LLM_PROVIDER="ollama"
GROQ_MODEL="openai/gpt-oss-20b"

# --- Runtime and browser access ---
# Local: "false". Render backend: "true" (disables server execution/imports).
PYGLIDE_HOSTED="false"
# Comma-separated frontend origins; use the deployed frontend URL on Render.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Lightweight default for local use and Render Free.
SEMANTIC_DEBUGGER_EMBEDDER="hash"
