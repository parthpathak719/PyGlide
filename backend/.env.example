# Copy this file to .env in the backend directory and enter your Sarvam key.
# An existing SARVAM_API_KEY environment variable takes priority.
SARVAM_API_KEY=

# Required only when deleting the bundled predefined example files.
EXAMPLE_DELETE_PASSWORD=

# Local default: ollama. Render deployment: groq.
LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Render sets this to true: disables server code execution and dataset ingestion.
PYGLIDE_HOSTED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEMANTIC_DEBUGGER_EMBEDDER=hash

# Optional: persist shared example deletions in Supabase (backend secrets only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
