# Frontend build settings. Copy this root .env.example to a root .env if needed.
# These VITE_ values are public and included in the browser build.
# Put API keys and passwords only in backend/.env; see backend/.env.example.

# --- Backend connection ---
# Local: http://localhost:8000. Hosted: your Render backend HTTPS URL.
VITE_API_URL="http://localhost:8000"

# --- AI provider shown in the interface ---
# Match backend LLM_PROVIDER ("ollama" locally, "groq" for hosted AI).
VITE_LLM_PROVIDER="ollama"
# Match backend GROQ_MODEL when using Groq.
VITE_GROQ_MODEL="openai/gpt-oss-20b"
